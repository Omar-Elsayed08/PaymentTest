# Copy to .env and fill in. Never commit .env.

# Stripe test keys while developing (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_replace_me

# Printed by: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Origin Stripe redirects back to, no trailing slash
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Optional
CURRENCY=usd
SHIPPING_CENTS=800
MAX_QTY_PER_LINE=20
MAX_CART_LINES=30
ALLOWED_SHIPPING_COUNTRIES=US,CA

# Only needed when the pages are served from a different host than the API,
# e.g. ALLOWED_ORIGINS=https://everythingburger.studio
ALLOWED_ORIGINS=
